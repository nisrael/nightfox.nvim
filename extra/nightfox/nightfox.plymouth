# Nightfox Plymouth theme
# name: nightfox
# upstream: https://github.com/edeneast/nightfox.nvim/raw/main/extra/nightfox/nightfox.plymouth
#
# Based on the `spinner` theme (ModuleName=two-step). The distribution
# watermark is replaced by the Nightfox logo. Install with
# `extra/plymouth/install.sh nightfox`.

[Plymouth Theme]
Name=Nightfox
Description=Spinner-style boot splash using the nightfox palette and the Nightfox logo watermark.
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell Light 30
ImageDir=/usr/share/plymouth/themes/nightfox

DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.7
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45

Transition=none
TransitionDuration=0.0

BackgroundStartColor=0x131a24
BackgroundEndColor=0x192330
ProgressBarBackgroundColor=0x29394f
ProgressBarForegroundColor=0x719cd6

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
_Title=Installing Updates...
_SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
_Title=Upgrading System...
_SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
UseFirmwareBackground=true
_Title=Upgrading Firmware...
_SubTitle=Do not turn off your computer
