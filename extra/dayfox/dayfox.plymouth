# Nightfox Dayfox Plymouth theme
# name: dayfox
# upstream: https://github.com/edeneast/nightfox.nvim/raw/main/extra/dayfox/dayfox.plymouth
#
# Based on the upstream `spinner` theme (the two-step splash plugin). The
# distribution watermark is replaced by the Nightfox logo. Install with
# `extra/plymouth/install.sh dayfox`.

[Plymouth Theme]
Name=Nightfox Dayfox
Description=Spinner-style boot splash using the dayfox palette and the Nightfox logo watermark.
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell Light 30
ImageDir=/usr/share/plymouth/themes/nightfox-dayfox

# Layout, top to bottom: the Nightfox logo (watermark), then the password
# entry (LUKS unlock / login), then the spinner. The plugin draws the prompt
# text and keyboard hints below the entry box, so the box sits just below
# center with the logo clear above it and the spinner clear below.
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.32
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.55
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.55
HorizontalAlignment=.5
VerticalAlignment=.76
MessageBelowAnimation=true

Transition=none
TransitionDuration=0.0

BackgroundStartColor=0xe4dcd4
BackgroundEndColor=0xf6f2ee
ProgressBarBackgroundColor=0xd3c7bb
ProgressBarForegroundColor=0x2848a9

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
UseFirmwareBackground=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer
